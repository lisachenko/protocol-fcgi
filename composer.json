{
    "name": "lisachenko/protocol-fcgi",
    "description": "Implementation of the FastCGI (FCGI) protocol in PHP",
    "license": "MIT",
    "keywords": ["fastcgi", "fcgi", "protocol", "network", "binary", "php-fpm"],
    "authors": [
        {
            "name": "Alexander Lisachenko",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.2"
    },
    "autoload": {
        "psr-4" : {
            "Lisachenko\\Protocol\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "Lisachenko\\Protocol\\" : "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "phpstan": "Run PHPStan static analysis",
        "check": "Run all quality checks"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
